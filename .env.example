# DeepSea Guardian — Environment Configuration
# Copy this file to .env.local and fill in your values.

# Authentication secret (minimum 32 characters)
AUTH_SECRET="your-secret-key-at-least-32-characters-long"

# Backend-only secrets (used by backend/src/routes/auth.ts)
# In production these MUST be set — the backend refuses to start without an
# AUTH_SECRET, and the demo admin login below only exists in development.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="change-me-to-a-long-password"

# API Key for programmatic access (optional)
# Clients can pass this via X-API-Key header to authenticate API requests
# API_KEY="your-api-key-here"

# Ocean map basemap (CARTO Basemaps API key)
# CARTO requires a key on its raster basemap tiles as of 23 Sep 2026 — without
# one, every tile renders as an "API key required" placeholder.
# Request a free key (no account needed) at https://carto.com/basemaps/apikey/
# then paste it here. Free tier: 5M tile requests/month non-commercial,
# 1M/month commercial. Add URL restrictions from https://dashboard.basemaps.carto.com
# Leave empty to fall back to key-free OpenStreetMap tiles (see OceanMap.tsx).
# NEXT_PUBLIC_* is required: the tile URL is built in the browser.
NEXT_PUBLIC_CARTO_BASMAPS_KEY=""

# Optional: AI assistant (falls back to the built-in local assistant when unset)
# ANTHROPIC_API_KEY=

# Optional: Analytics / Monitoring
# NEXT_PUBLIC_ANALYTICS_ID=

# Python interpreter used to run the ML scripts in ml/
# The backend auto-detects a project venv (.venv / venv) or an interpreter that
# can import numpy/sklearn/PIL/joblib, so this is usually unnecessary. Set it
# explicitly when several Pythons are installed and the wrong one is picked.
# Windows example:  PYTHON_BIN=C:\Python314\python.exe
# Linux/macOS:      PYTHON_BIN=./.venv/bin/python
# PYTHON_BIN=

# Optional: API rate limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=60000

# Optional: Set to "true" to enable bundle analyzer
# ANALYZE=true
